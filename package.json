{
	"name": "radar-lembata",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"setup": "bun run scripts/setup.ts",
		"auth:secret": "bun run scripts/generate-secret.ts",
		"auth:generate": "bunx @better-auth/cli generate --config ./lib/auth.ts --output ./db/auth-schema.ts -y",
		"db:generate": "bunx drizzle-kit generate",
		"db:push": "bunx drizzle-kit push",
		"db:migrate": "bunx drizzle-kit migrate",
		"db:seed": "bun run db/seed.ts",
		"db:studio": "bunx drizzle-kit studio",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@neondatabase/serverless": "^1.1.0",
		"@shadcn/react": "^0.3.1",
		"better-auth": "^1.7.6",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"cn": "^0.4.0",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.3",
		"drizzle-zod": "^0.8.3",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.5.0",
		"lucide-react": "^1.48.0",
		"next": "16.3.6",
		"next-themes": "^0.4.6",
		"postgres": "^3.4.9",
		"qrcode": "^1.5.4",
		"react": "19.2.8",
		"react-day-picker": "^10.0.2",
		"react-dom": "19.2.8",
		"react-resizable-panels": "^4.13.3",
		"recharts": "3.8.0",
		"shadcn": "^4.21.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@tailwindcss/postcss": "^4",
		"@types/bun": "^1.4.2",
		"@types/node": "^20",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"drizzle-kit": "^0.31.11",
		"tailwindcss": "^4",
		"typescript": "^5"
	},
	"packageManager": "bun@1.4.2",
	"ignoreScripts": ["sharp", "unrs-resolver"],
	"trustedDependencies": ["esbuild", "sharp", "unrs-resolver"]
}
